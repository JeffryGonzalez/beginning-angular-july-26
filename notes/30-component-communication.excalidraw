      "seed": 1209812710,
      "version": 364,
      "versionNonce": 896316134,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785347751888,
      "link": null,
      "locked": false,
      "text": "services:\n    - have a scope and lifetime\n    - scope is where they can be seen in your application\n    - lifetime is when they get created and when they are removed from memory.\n    - with @Service() - the scope is \"global\" and the lifetime is it is created the first time\n      it is injected and it stays in memory until the app closes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "services:\n    - have a scope and lifetime\n    - scope is where they can be seen in your application\n    - lifetime is when they get created and when they are removed from memory.\n    - with @Service() - the scope is \"global\" and the lifetime is it is created the first time\n      it is injected and it stays in memory until the app closes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
