      "versionNonce": 375806906,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785339381791,
      "link": null,
      "locked": false,
      "text": "inputs allow a parent to pass\nsome data to a child component.\nit's delegation.\n\n\noutputs are events -\nthey cannot be required.\nthey are a way of telling\nthe parent something happened\nit may be interested in.\nYou can have as many outputs as you like\nbut each output can only send one \"thing\":\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "inputs allow a parent to pass\nsome data to a child component.\nit's delegation.\n\n\noutputs are events -\nthey cannot be required.\nthey are a way of telling\nthe parent something happened\nit may be interested in.\nYou can have as many outputs as you like\nbut each output can only send one \"thing\":\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
